# Settings for deploy/vm/compose.yaml. Copy to .env.vm (git-ignored) on the VM and fill in.
# Never commit .env.vm: it holds your secrets.

# --- The VM ---
# The host of the HTTPS address people open, without https:// —
#   option A: the host of the Brev tunnel URL for port 3000;
#   option B: your domain, or <public-ip-with-dashes>.sslip.io (Caddy gets the certificate).
DOMAIN=threadmap.example.com
# Database password (any long random string), e.g. `openssl rand -base64 32`.
# Only for the bundled database; not needed with Supabase.
POSTGRES_PASSWORD=
# With the database on Supabase (compose.supabase.yaml): the Session pooler URI (port 5432),
# password filled in. Put Supabase's CA next to compose.yaml as supabase-ca.crt.
SUPABASE_DB_URL=

# --- App secrets: generate once with `npm run secrets:generate` and keep them ---
# Losing WHATSAPP_AUTH_ENCRYPTION_KEY means scanning the QR code again.
BETTER_AUTH_SECRET=
WHATSAPP_AUTH_ENCRYPTION_KEY=
NEBIUS_API_KEY=

# --- App ---
NODE_ENV=production
# "development" here only means the database is reached without TLS, over Docker's private network.
APP_MODE=development
SOURCE_PROVIDER=baileys
WHATSAPP_PAIRING_ENABLED=true
PUBLIC_DEMO_ENABLED=true
LOCAL_STORAGE_DIR=/app/.data/objects
WHATSAPP_HISTORY_MAX_MESSAGES_PER_CHAT=3000
# Delete an account (unlink + all its data) once no ThreadMap page has been open this many minutes; 0 = never.
AUTO_DELETE_AFTER_MINUTES=30

# --- NVIDIA Nemotron on Nebius Token Factory ---
LLM_PROVIDER=nebius
LLM_CONCURRENCY=4
NEBIUS_MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_BALANCED=nvidia/nemotron-3-super-120b-a12b
NEBIUS_JSON_SCHEMA_ROLES=reasoning,fast,balanced

# --- Spending limits (US$). 0 for the per-user cap means no per-user cap. ---
LLM_MAX_USD_PER_USER=0.2
LLM_MAX_USD_PER_JOB=1
LLM_MAX_USD_PER_DAY=5
LLM_MAX_CALLS_PER_JOB=100
# Phone numbers (digits, country code first, comma-separated) exempt from the US$ caps.
LLM_UNLIMITED_PHONES=
