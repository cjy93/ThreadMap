{
  "name": "threadmap",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:companion": "tsx src/processes/companion.ts",
    "dev:worker": "tsx src/processes/worker.ts",
    "build": "next build && node scripts/build-processes.mjs",
    "start": "node dist/supervisor.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "fixtures:generate": "tsx src/cli/generate-fixtures.ts",
    "fixtures:load": "tsx src/cli/load-fixtures.ts",
    "secrets:generate": "tsx src/cli/generate-secrets.ts",
    "models:discover": "tsx src/cli/discover-models.ts",
    "origin:bootstrap": "tsx src/cli/bootstrap-origin.ts",
    "deploy:validate": "bash deploy/nebius/deploy.sh validate",
    "perf:run": "tsx src/cli/perf.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "image:build": "docker build -t threadmap:local .",
    "live:inference": "tsx src/cli/live-inference.ts",
    "grants:apply": "tsx src/cli/apply-grants.ts",
    "cloud:verify": "node scripts/cloud-verify.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@xyflow/react": "12.12.0",
    "baileys": "7.0.0-rc14",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "openai": "7.43.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
