# ThreadMap v2.2 recursive topics, display depth, and message-count node sizing.
# Use SecretStash references for hosted secrets, not a committed deployment .env.
# An ignored development environment file may contain local test values.
# No credentials are supplied in this example.
# The implementation must provide a setup command that generates secrets
# privately and must never expose provider secrets to browser bundles.
# The supervisor injects each secret only into the process that needs it.
# No BAILEYS_API_KEY or Node.js account credential exists or is required.

DEPLOYMENT_TARGET=nebius_serverless_endpoint
NODE_ENV=production
APP_MODE=hosted
PORT=3000

# Nebius assigns the public HTTPS URL after endpoint creation. The deploy CLI
# reads it and writes the exact trusted origin into DB runtime_settings.
# Refuse authentication/pairing until configured; never trust arbitrary Host.
# APP_URL/BETTER_AUTH_URL may name an explicitly established origin instead.
PUBLIC_ORIGIN_MODE=database_bootstrap
# Deployment tooling generates and retains a unique nonsecret ID for this Endpoint.
DEPLOYMENT_ID=
APP_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Managed PostgreSQL private endpoint in the same VPC, with verified TLS.
# Inject each restricted role's URL from SecretStash; no superuser runtime role.
DATABASE_URL=
COMPANION_DATABASE_URL=
WORKER_DATABASE_URL=

# Private Nebius Object Storage. Endpoint disk is not durable across stop/start.
# Resolve endpoint/region from the selected cloud region; keys from SecretStash.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DEFAULT_DISPLAY_TIMEZONE=Asia/Singapore
PUBLIC_DEMO_ENABLED=true
PUBLIC_DEMO_PAIRING_ENABLED=false

# Primary connector: cloud Node process supervised inside the endpoint image.
# No public companion port. Public demo guests always use an isolated fixture
# source and cannot pair or access private workspaces, even on this same host.
SOURCE_PROVIDER=baileys
WHATSAPP_PAIRING_ENABLED=true

# Generate 32 random bytes privately, encode as base64, retain in SecretStash.
# Companion-only key encrypts credentials AND Signal keys in restricted DB tables.
# The implementation must persist creds.update and keys.set correctly.
# Do not use an unencrypted useMultiFileAuthState folder as the deployment store.
# Losing this key requires relinking; do not silently generate a new key at restart.
WHATSAPP_AUTH_ENCRYPTION_KEY=

# Available history is bounded and best-effort, not a complete-archive guarantee.
# The history cap is NOT a live-message cap; new selected messages continue.
WHATSAPP_INITIAL_SYNC_MODE=available_history
WHATSAPP_HISTORY_MAX_MESSAGES_PER_CHAT=10000

# Short-lived cloud-memory buffer while the owner chooses chats after pairing.
# Unselected content never enters permanent source storage or an LLM prompt.
# 30 minutes after a QR scan (like auto-delete); after that the chat list shows
# only opened chats, and linking again is the way to add more.
WHATSAPP_PRESELECTION_BUFFER_MIB=32
WHATSAPP_PRESELECTION_BUFFER_TTL_SECONDS=1800
WHATSAPP_MARK_ONLINE_ON_CONNECT=false

# Metadata first; fetch permitted media when requested by the user.
MEDIA_DOWNLOAD_MODE=opened_chat_images
MAX_ATTACHMENT_MIB=50
MAX_MEDIA_CACHE_MIB=500
AUTO_READ_DWELL_MS=2000

# View defaults, not limits on stored/LLM-generated topic depth.
# Roots are depth 0; users may choose 0/1/2/3/custom nonnegative integer/all.
# Save per-user/per-chat overrides in PostgreSQL; explicit URL value wins.
# All levels is progressively loaded, with a finite visible-node budget.
MAP_DEFAULT_TOPIC_DEPTH=2
MAP_MAX_VISIBLE_NODES=200
MAP_CONTENT_PAGE_SIZE=50
# Shared circular-node diameter bounds in unzoomed graph pixels.
# Use compressed-area sizing from DISTINCT matching human messages, including
# all recursive descendants, independently of visible depth or graph pages.
MAP_NODE_MIN_DIAMETER_PX=64
MAP_NODE_MAX_DIAMETER_PX=220
MAP_NODE_SIZE_REFERENCE_COUNT=10000
# Reference count is a visual saturation point only: exact count badges are
# never capped. These values do not limit capture, retention, or topic depth.
# Validate finite positive diameters with min < max and a positive safe-integer
# reference count. Do not normalize to the largest currently visible node.
# Do not add a TAXONOMY_MAX_DEPTH cap. Per-call token/output limits and the
# logical-job budget bound refinement work; persist unfinished frontiers.
# Ancestor messages/files and counts include all matching descendants,
# regardless of display depth or the current graph/content page.

# Fixture source/model modes are development tools, not live-gate evidence.
LLM_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Resolve exact IDs using the authenticated model catalog, then capability-test.
NEBIUS_MODEL_REASONING=
NEBIUS_MODEL_FAST=
NEBIUS_MODEL_BALANCED=
ALLOW_REASONING_FALLBACK=false
NEBIUS_MODEL_REASONING_FALLBACK=

# Example policy caps chosen for this application, not vendor price forecasts.
# Owner should choose these values before live processing.
# A job is a bounded initial-history analysis unit or incremental microbatch.
LLM_MAX_USD_PER_JOB=1.00
LLM_MAX_USD_PER_DAY=5.00
LLM_MAX_CALLS_PER_JOB=100
LLM_MICROBATCH_MAX_MESSAGES=60
LLM_MICROBATCH_MAX_WAIT_MS=3000
LLM_MAX_INPUT_TOKENS_PER_CALL=8000
LLM_MAX_OUTPUT_TOKENS_PER_CALL=4096
LLM_CONCURRENCY=2
LLM_HTTP_TIMEOUT_MS=120000
LLM_MAX_NETWORK_RETRIES=2
LLM_MAX_SCHEMA_REPAIRS=1

# Optional telemetry. Hiding inputs/outputs does not sanitize arbitrary metadata.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=threadmap
LANGSMITH_ENDPOINT=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
TRACE_PRIVATE_CONTENT=false

# Optional P1 public-link enrichment.
ENABLE_WEB_ENRICHMENT=false
TAVILY_API_KEY=

# Optional P1 semantic retrieval.
ENABLE_SEMANTIC_SEARCH=false
EMBEDDING_MODEL=

# Toloka/Tendem are omitted from the core runtime.

# Deployment inputs for the cloud CLI/IaC, not public browser configuration.
# Cloud IAM comes from an authenticated CLI/service account, not NEBIUS_API_KEY.
# Provision a regular CPU endpoint; resolve a supported CPU platform and preset.
# Image must be an immutable tested tag/digest in an accessible registry.
NEBIUS_CLOUD_PROJECT_ID=
NEBIUS_CLOUD_SUBNET_ID=
NEBIUS_CLOUD_REGION=
NEBIUS_ENDPOINT_NAME=threadmap
NEBIUS_ENDPOINT_PLATFORM=
NEBIUS_ENDPOINT_PRESET=
NEBIUS_ENDPOINT_IMAGE=

# Record only after a successful create; never invent an ID or HTTPS URL.
NEBIUS_ENDPOINT_ID=

# Before provisioning, the owner must configure an infrastructure spending plan
# covering endpoint compute/disk, Managed PostgreSQL, S3 and other cloud charges.
# LLM_MAX_USD_* protects inference only; it is not a cloud billing hard limit.
# Optional Serverless Jobs are P1 finite work, never the persistent companion.
