# ThreadMap settings for docker compose: no secrets (those are in the git-ignored .env.compose).
# compose.yaml loads this file first, then .env.compose, so a key in .env.compose wins.

NODE_ENV=production
APP_MODE=development
PUBLIC_ORIGIN_MODE=database_bootstrap
DEPLOYMENT_ID=tm-dc710eaf
SOURCE_PROVIDER=baileys
LLM_PROVIDER=nebius
LLM_CONCURRENCY=4
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/app/.data/objects
PUBLIC_DEMO_ENABLED=true
WHATSAPP_PAIRING_ENABLED=true
NEBIUS_MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_BALANCED=nvidia/nemotron-3-super-120b-a12b
NEBIUS_JSON_SCHEMA_ROLES=reasoning,fast,balanced
WHATSAPP_HISTORY_MAX_MESSAGES_PER_CHAT=1000000
# Per-user AI allowance. Your own number (no caps) is LLM_UNLIMITED_PHONES in .env.compose.
# Caps DISABLED for local development (28 Oct). Before deploying, restore:
#   LLM_MAX_USD_PER_USER=0.20, and delete the three lines below it (defaults: $1/job, $5/day, 100 calls/job).
LLM_MAX_USD_PER_USER=0
LLM_MAX_USD_PER_JOB=1000
LLM_MAX_USD_PER_DAY=1000
LLM_MAX_CALLS_PER_JOB=0
NEBIUS_PRICE_JSON={"nvidia/Nemotron-3-Ultra-550b-a55b":{"input":1.0,"output":3.0},"nvidia/nemotron-3-super-120b-a12b":{"input":0.3,"output":0.9},"nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B":{"input":0.06,"output":0.24}}
STUDY_MAP_MAX_SEARCHES=4
